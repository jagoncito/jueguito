extends SceneTree
func _initialize() -> void:
	var bag := BituInventory.new()
	assert(bag.add_item("tomate",980)==0)
	assert(bag.add_item("tomate-pristino",5)==0)
	assert(bag.move_stack(0,23,true))
	assert(bag.item_at(0).amount==490 and bag.item_at(23).amount==490)
	assert(bag.count("tomate")==980)
	assert(not bag.move_stack(23,1,true),"Una mitad no mezcla calidades distintas")
	assert(bag.move_stack(1,0),"Intercambiar pilas de distintas calidades")
	assert(bag.item_at(0).id=="tomate-pristino" and bag.item_at(1).id=="tomate")
	assert(bag.move_stack(23,1) and bag.item_at(23).is_empty())
	assert(bag.count("tomate")==980 and bag.count("tomate-pristino")==5)
	assert(bag.add_item("tomate",70)==0)
	assert(bag.item_at(1).amount==1000)
	bag.sort_items()
	assert(bag.count("tomate")==1050 and bag.count("tomate-pristino")==5)
	assert(bag.used_slots()==3)
	print("BITU_BACKPACK_SMOKE_OK: mover/dividir/fusionar/intercambiar/ordenar sin pérdidas")
	quit()
